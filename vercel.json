{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"test\" ]; then exit 1; else exit 0; fi",
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "test": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/dispatcher",
      "schedule": "0 6 * * *"
    }
  ]
}

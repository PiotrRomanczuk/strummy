# Strummy local-server cron trigger — config template.
#
# To ACTIVATE (optional): copy to the box, restrict perms, fill the secret,
# then enable the timers (see README.md):
#   install -m 600 strummy-cron.env.example ~/.config/strummy-cron.env
#   # edit ~/.config/strummy-cron.env and uncomment/set CRON_SECRET
#
PRODUCTION_URL=https://strummy.vercel.app
# CRON_SECRET=paste-the-prod-cron-secret-here   # uncomment + set to activate

{
  "partitions": { "audit_log": "^audit_log_(\\d{4}_\\d{2}|default)$" },
  "tables": {
    "agent_execution_logs": {
      "keep": [
        "agent_id",
        "created_at",
        "error_code",
        "execution_time",
        "id",
        "input_hash",
        "profile_id",
        "request_id",
        "successful",
        "timestamp"
      ]
    },
    "ai_conversations": {
      "keep": [
        "context_id",
        "context_type",
        "created_at",
        "id",
        "is_archived",
        "model_id",
        "profile_id",
        "updated_at"
      ],
      "text": ["title"]
    },
    "ai_generations": {
      "keep": [
        "agent_id",
        "context_entity_id",
        "context_entity_type",
        "created_at",
        "generation_type",
        "id",
        "is_starred",
        "is_successful",
        "model_id",
        "profile_id",
        "provider",
        "updated_at"
      ],
      "json": ["input_params"],
      "text": ["error_message", "output_content"]
    },
    "ai_messages": {
      "keep": [
        "conversation_id",
        "created_at",
        "id",
        "is_helpful",
        "latency_ms",
        "model_id",
        "role",
        "tokens_used"
      ],
      "text": ["content"]
    },
    "ai_prompt_templates": {
      "keep": [
        "category",
        "created_at",
        "created_by",
        "description",
        "id",
        "is_active",
        "is_system",
        "name",
        "prompt_template",
        "updated_at",
        "variables"
      ]
    },
    "ai_usage_stats": {
      "keep": [
        "created_at",
        "date",
        "error_count",
        "id",
        "model_id",
        "profile_id",
        "request_count",
        "total_latency_ms",
        "total_tokens",
        "updated_at"
      ]
    },
    "ai_workflow_runs": {
      "keep": [
        "created_at",
        "created_by",
        "current_step",
        "id",
        "lesson_id",
        "status",
        "updated_at",
        "workflow_type"
      ],
      "json": ["input", "step_results"]
    },
    "api_keys": { "truncate": true },
    "apple_shortcut_song_import_log": {
      "keep": [
        "created_at",
        "error_message",
        "http_status",
        "id",
        "song_artist",
        "song_id",
        "song_title",
        "source",
        "spotify_track_id",
        "spotify_url",
        "status",
        "user_id"
      ]
    },
    "assignment_history": {
      "keep": ["assignment_id", "change_type", "changed_at", "changed_by", "created_at", "id"],
      "json": ["new_data", "previous_data"],
      "text": ["notes"]
    },
    "assignment_templates": {
      "keep": ["checklist", "created_at", "id", "teacher_id", "title", "updated_at"],
      "text": ["description"]
    },
    "assignments": {
      "keep": [
        "checklist",
        "chord_drill",
        "chord_drill_result",
        "created_at",
        "daily_target_minutes",
        "deleted_at",
        "due_date",
        "id",
        "lesson_id",
        "song_id",
        "status",
        "student_id",
        "submission_type",
        "teacher_id",
        "updated_at"
      ],
      "text": ["description", "title"]
    },
    "audit_log": {
      "keep": ["action", "actor_id", "created_at", "entity_id", "entity_type", "id"],
      "json": ["changes", "metadata"]
    },
    "auth_events": { "truncate": true },
    "auth_rate_limits": { "truncate": true },
    "billing_customers": { "truncate": true },
    "billing_settings": {
      "keep": ["billing_start_on", "created_at", "payment_term_days", "teacher_id", "updated_at"]
    },
    "chord_quiz_attempts": {
      "keep": [
        "chord_id",
        "created_at",
        "id",
        "is_correct",
        "response_time_ms",
        "selected_answer",
        "student_id"
      ]
    },
    "chord_srs": {
      "keep": [
        "chord_id",
        "created_at",
        "ease_factor",
        "id",
        "interval_days",
        "last_reviewed_at",
        "next_review_at",
        "repetitions",
        "student_id",
        "updated_at"
      ]
    },
    "content_post_metrics": {
      "keep": [
        "captured_at",
        "comments_count",
        "created_at",
        "id",
        "likes_count",
        "notes",
        "post_id",
        "saves_count",
        "shares_count",
        "views_count"
      ]
    },
    "content_posts": {
      "keep": [
        "caption",
        "comments_count",
        "created_at",
        "engagement_rate",
        "external_post_id",
        "external_url",
        "extra_hashtags",
        "hashtag_set_ids",
        "hook",
        "id",
        "likes_count",
        "metrics_updated_at",
        "notes",
        "platform",
        "published_at",
        "saves_count",
        "scheduled_at",
        "shares_count",
        "song_id",
        "song_video_id",
        "status",
        "stories",
        "updated_at",
        "views_count"
      ]
    },
    "drive_files": {
      "keep": [
        "created_at",
        "deleted_at",
        "display_order",
        "entity_id",
        "entity_type",
        "file_size_bytes",
        "file_type",
        "google_drive_file_id",
        "google_drive_folder_id",
        "id",
        "mime_type",
        "updated_at",
        "uploaded_by",
        "visibility"

    "fretboard_presets": { "keep": ["created_at", "id", "name", "profile_id", "query"] },
    "hashtag_sets": {
      "keep": ["created_at", "description", "hashtags", "id", "is_active", "name", "updated_at"]
    },
    "in_app_notifications": {
      "keep": [
        "action_label",
        "action_url",
        "created_at",
        "entity_id",
        "entity_type",
        "expires_at",
        "icon",
        "id",
        "is_read",
        "notification_type",
        "priority",
        "profile_id",
        "read_at",
        "updated_at",
        "variant"

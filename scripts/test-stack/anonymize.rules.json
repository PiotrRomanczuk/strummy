        "summary_sent_at",
        "teacher_id",
        "updated_at"
      ],
      "text": ["notes", "summary", "title"]
    },
    "notification_log": { "truncate": true },
    "notification_preferences": {
      "keep": [
        "created_at",
        "delivery_channel",
        "enabled",
        "id",
        "notification_type",
        "profile_id",
        "updated_at"
